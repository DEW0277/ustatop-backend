#!/usr/bin/env bash
# agy-run — Antigravity CLI (agy) ni headless rejimda ishonchli chaqirish.
#
# Nega kerak: `agy -p` stdout TTY bo'lmasa javobni yo'qotadi, o'z scratch
# papkasida ishlaydi va timeout'i yo'q. Bu wrapper:
#   * pseudo-TTY orqali ishga tushiradi (macOS: script -q /dev/null, Linux: script -qec)
#   * ishchi papkani --add-dir bilan bog'laydi
#   * qattiq timeout qo'yadi (coreutils `timeout` shart emas)
#   * har bir chaqiruvni ~/.agent-logs/agent-runs.jsonl ga yozadi
#
# Foydalanish:
#   agy-run [-C dir] [-m model] [-t timeout_sec] [-o out_file] "prompt"
#   echo "prompt" | agy-run -C . -
#
# Muhit o'zgaruvchilari:
#   AGY_MODEL            default model (bo'sh bo'lsa agy sozlamasidagi model)
#   AGY_SKIP_PERMISSIONS 1 (default) — headless rejimda tasdiq so'rovlari javobsiz qoladi,
#                        shu sabab --dangerously-skip-permissions ishlatiladi.
#                        Xavfli buyruqlarni ~/.gemini/antigravity-cli/settings.json deny-list bilan cheklang.
#   AGENT_LOG_DIR        log papkasi (default ~/.agent-logs)
#   AGENT_ISSUE          log uchun issue raqami (ixtiyoriy)
set -uo pipefail

dir="$PWD"
model="${AGY_MODEL:-}"
timeout_sec=1200
out_file=""

usage() { sed -n '2,22p' "$0" | sed 's/^# \{0,1\}//'; exit 64; }

while getopts ":C:m:t:o:h" opt; do
  case "$opt" in
    C) dir="$OPTARG" ;;
    m) model="$OPTARG" ;;
    t) timeout_sec="$OPTARG" ;;
    o) out_file="$OPTARG" ;;
    h) usage ;;
    *) usage ;;
  esac
done
shift $((OPTIND - 1))

[ $# -ge 1 ] || usage
if [ "$1" = "-" ]; then task="$(cat)"; else task="$*"; fi

command -v agy >/dev/null 2>&1 || { echo "agy-run: 'agy' topilmadi. O'rnatish: curl -fsSL https://antigravity.google/cli/install.sh | bash" >&2; exit 127; }
dir="$(cd "$dir" && pwd)" || { echo "agy-run: papka yo'q: $dir" >&2; exit 66; }

preamble="You are a worker agent dispatched by an orchestrator. Work ONLY inside: ${dir}
Rules:
- Run real commands and paste their real output. Never invent command output, test results or file contents.
- Change only what the task asks. Do not refactor unrelated code. Do not touch .github/, CI config, secrets or .env files.
- Do NOT run git commit, git push, rm -rf, or any deploy command. The orchestrator commits.
- If a command is denied or you are blocked, say BLOCKED: <reason> verbatim and stop.
- Finish with a section 'CHANGED FILES:' listing every file you created or modified, then 'TESTS:' with the exact test command(s) you ran and their pass/fail result.

TASK:
"

full_prompt="${preamble}${task}"

args=(-p "$full_prompt" --add-dir "$dir")
[ -n "$model" ] && args+=(--model "$model")
[ "${AGY_SKIP_PERMISSIONS:-1}" = "1" ] && args+=(--dangerously-skip-permissions)

tmp_out="$(mktemp -t agy-run.XXXXXX)"
start_epoch="$(date +%s)"

# pseudo-TTY bilan ishga tushirish (platformaga qarab)
run_with_pty() {
  if [ "$(uname -s)" = "Darwin" ]; then
    (cd "$dir" && script -q /dev/null agy "${args[@]}")
  else
    local quoted
    quoted="$(printf '%q ' agy "${args[@]}")"
    (cd "$dir" && script -qec "$quoted" /dev/null)
  fi
}

run_with_pty >"$tmp_out" 2>&1 &
pid=$!

# watchdog: timeout bo'lsa protsessni to'xtatadi
( sleep "$timeout_sec"; if kill -0 "$pid" 2>/dev/null; then echo "agy-run: TIMEOUT ${timeout_sec}s" >>"$tmp_out"; pkill -TERM -P "$pid" 2>/dev/null; kill -TERM "$pid" 2>/dev/null; sleep 5; pkill -KILL -P "$pid" 2>/dev/null; kill -KILL "$pid" 2>/dev/null; fi ) &
watchdog=$!

wait "$pid"
rc=$?
kill "$watchdog" 2>/dev/null
wait "$watchdog" 2>/dev/null

end_epoch="$(date +%s)"
duration=$((end_epoch - start_epoch))

# CR belgilarini olib tashlash (script qo'shadi)
tr -d '\r' <"$tmp_out" >"${tmp_out}.clean"
if grep -q "agy-run: TIMEOUT" "${tmp_out}.clean"; then rc=124; fi
if [ "$rc" -eq 0 ] && [ ! -s "${tmp_out}.clean" ]; then rc=65; echo "agy-run: bo'sh javob (agy hech narsa qaytarmadi)" >>"${tmp_out}.clean"; fi

cat "${tmp_out}.clean"
[ -n "$out_file" ] && cp "${tmp_out}.clean" "$out_file"

# kuzatuv (observability) — har bir chaqiruv bir JSON qatori
log_dir="${AGENT_LOG_DIR:-$HOME/.agent-logs}"
mkdir -p "$log_dir" 2>/dev/null && {
  result="ok"; [ "$rc" -eq 124 ] && result="timeout"; [ "$rc" -ne 0 ] && [ "$rc" -ne 124 ] && result="error"
  printf '{"ts":"%s","stage":"code","agent":"gemini-agy","model":"%s","issue":"%s","dir":"%s","duration_s":%s,"exit":%s,"result":"%s","cost_usd":null}\n' \
    "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "${model:-agy-default}" "${AGENT_ISSUE:-}" "$dir" "$duration" "$rc" "$result" >>"$log_dir/agent-runs.jsonl"
}

rm -f "$tmp_out" "${tmp_out}.clean"
exit "$rc"
