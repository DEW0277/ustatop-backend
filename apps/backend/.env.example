PORT=3000
NODE_ENV=development

# PostgreSQL (docker-compose service: postgres)
DATABASE_URL="postgresql://ustatop:ustatop_dev_pass@localhost:5455/ustatop_db?schema=public"

# Redis (docker-compose service: redis) — OTP storage, rate limiting
REDIS_URL="redis://localhost:6379"

# JWT — original spec faqat bitta token qaytaradi (refresh endpoint yo'q), shu bilan mos
JWT_SECRET="change_me_in_production"
JWT_EXPIRES_IN="30d"

# OTP
OTP_TTL_SECONDS=120
# 4-6. Mobil ilovada hozir 4 ta katak bor; spec 6 xonali (123456). Mock rejimida kod "123456"ning boshi bo'ladi.
OTP_LENGTH=6

# MinIO (S3-compatible) — dev: docker-compose service, prod: Contabo VPS container
MINIO_ENDPOINT="localhost"
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY="ustatop"
MINIO_SECRET_KEY="ustatop_dev_secret"
MINIO_BUCKET="ustatop-uploads"
STORAGE_PUBLIC_URL="http://localhost:9000/ustatop-uploads"

# SMS OTP — hozircha mock (test kodi: 123456), keyinchalik "eskiz" ga o'zgartiriladi
SMS_MODE="mock"
SMS_PROVIDER_API_KEY=""

# Admin panel uchun birinchi ADMIN (prisma db seed yaratadi). Bo'sh qoldirilsa admin yaratilmaydi.
ADMIN_PHONE="+998900000001"

# Firebase Cloud Messaging (push notifications) — ixtiyoriy, hozircha bo'sh qoldirilishi mumkin
FIREBASE_PROJECT_ID=""
FIREBASE_CLIENT_EMAIL=""
FIREBASE_PRIVATE_KEY=""
