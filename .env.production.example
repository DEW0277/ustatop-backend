# Production muhit o'zgaruvchilari. VPS'da:  cp .env.production.example .env.production  va qiymatlarni to'ldiring.
# .env.production HECH QACHON commit qilinmaydi (.gitignore). To'liq yo'riqnoma: docs/DEPLOY.md

# --- Domen -----------------------------------------------------------------
# Bitta domen: https://DOMAIN (admin panel), https://DOMAIN/api/v1 (API), https://DOMAIN/uploads (fayllar)
DOMAIN=example.uz

# --- Postgres (parol:  openssl rand -hex 24) ---------------------------------
POSTGRES_USER=ustatop
POSTGRES_PASSWORD=
POSTGRES_DB=ustatop_db

# --- MinIO (parol kamida 8 belgi:  openssl rand -hex 24) ----------------------
MINIO_ROOT_USER=ustatop
MINIO_ROOT_PASSWORD=
MINIO_BUCKET=ustatop-uploads

# --- Auth --------------------------------------------------------------------
# Kamida 32 belgi, aks holda backend ishga tushmaydi:  openssl rand -hex 32
JWT_SECRET=
JWT_EXPIRES_IN=30d
OTP_TTL_SECONDS=120
OTP_LENGTH=6

# SMS. Haqiqiy provider (Eskiz.uz) hali ulanmagan. `mock` rejimida OTP DOIM 123456 — ya'ni istalgan
# telefon raqami (jumladan ADMIN) nomidan kirish mumkin. Shuning uchun production'da mock standart
# taqiqlangan; faqat yopiq sinov davrida, xavfni tushungan holda quyidagini `true` qiling.
SMS_MODE=mock
ALLOW_MOCK_SMS_IN_PRODUCTION=false
SMS_PROVIDER_API_KEY=

# Birinchi ADMIN telefon raqami — `prisma db seed` yaratadi (docs/DEPLOY.md).
ADMIN_PHONE=

# --- Push --------------------------------------------------------------------
# log (mock) | fcm. fcm bo'lsa uchala FIREBASE_* majburiy; FIREBASE_PRIVATE_KEY bitta qatorda, `\n` bilan.
PUSH_PROVIDER=log
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# --- Boshqa ------------------------------------------------------------------
# Swagger (/api/docs) production'da standart yopiq.
SWAGGER_ENABLED=false
# Qaysi image tegi ishga tushirilsin (rollback uchun — docs/DEPLOY.md).
IMAGE_TAG=latest
